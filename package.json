{
	"name": "ckeditor5-elements-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"scripts": {
		"dev": "pnpm docs:dev",
		"build": "tsc --build tsconfig.packages.json && node scripts/buildUmbrellaStyles.js",
		"clean": "node scripts/clean.js",
		"watch": "tsc --build --watch tsconfig.packages.json",
		"publish:all": "pnpm run clean && pnpm run build && pnpm -r publish --access public",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm lint:packages && pnpm format:check && pnpm test:coverage && pnpm docs:build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "pnpm build && node scripts/typecheck.js",
		"docs:dev": "pnpm --filter docs dev",
		"example": "pnpm --filter ckeditor5-elements-example dev",
		"example:docbook": "pnpm --filter ckeditor5-elements-docbook-example dev",
		"example:dita": "pnpm --filter ckeditor5-elements-dita-example dev",
		"docs:build": "pnpm --filter docs build",
		"lint:css": "node scripts/checkCssVariables.js",
		"lint:packages": "node scripts/checkPackages.js",
		"version:set": "node scripts/setVersion.js",
		"smoke": "node scripts/smokeTest.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.1.1",
		"@vitest/coverage-v8": "^5.1.1",
		"ckeditor5": "^49.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
