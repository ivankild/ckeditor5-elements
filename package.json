{
	"name": "ckeditor5-elements-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "pnpm docs:dev",
		"build": "tsc --build tsconfig.packages.json && node scripts/buildUmbrellaStyles.js",
		"clean": "node scripts/clean.js",
		"watch": "tsc --build --watch tsconfig.packages.json",
		"publish:all": "pnpm run clean && pnpm run build && pnpm -r publish --access public --tag alpha",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm lint:packages && pnpm format:check && pnpm test",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "pnpm build && node scripts/typecheck.js",
		"docs:dev": "pnpm --filter docs dev",
		"example": "pnpm --filter ckeditor5-elements-example dev",
		"docs:build": "pnpm --filter docs build",
		"lint:css": "node scripts/checkCssVariables.js",
		"lint:packages": "node scripts/checkPackages.js",
		"version:set": "node scripts/setVersion.js",
		"smoke": "node scripts/smokeTest.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"ckeditor5": "^49.0.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
