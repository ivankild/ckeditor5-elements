{
	"name": "ckeditor5-elements-context-menu",
	"version": "0.1.0",
	"description": "A context menu for CKEditor 5 elements, with clipboard actions (copy, cut, paste, paste before/after) and submenus.",
	"keywords": [
		"ckeditor",
		"ckeditor5",
		"ckeditor 5",
		"ckeditor5-feature",
		"ckeditor5-plugin"
	],
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./index.css": "./theme/elementContextMenu.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"theme",
		"README.md"
	],
	"sideEffects": [
		"*.css"
	],
	"dependencies": {
		"ckeditor5-elements-ui": "workspace:^"
	},
	"peerDependencies": {
		"ckeditor5": ">=46.0.0"
	},
	"scripts": {
		"build": "tsc --build",
		"prepublishOnly": "npm run build"
	}
}
