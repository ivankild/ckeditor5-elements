{
	"name": "ckeditor5-elements",
	"version": "49.0.0",
	"description": "Element commands, an element context menu, element actions and clipboard commands, element attributes, an element schema, selectable and clickable elements, element toolbars, quick insert and breadcrumbs for CKEditor 5.",
	"keywords": [
		"ckeditor",
		"ckeditor5",
		"ckeditor 5",
		"ckeditor5-feature",
		"ckeditor5-plugin"
	],
	"license": "MIT",
	"author": "Ivan Kildyushov",
	"homepage": "https://ivankild.github.io/ckeditor5-elements/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ivankild/ckeditor5-elements.git",
		"directory": "packages/ckeditor5-elements"
	},
	"bugs": {
		"url": "https://github.com/ivankild/ckeditor5-elements/issues"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./index.css": "./dist/index.css",
		"./validate-schema": {
			"types": "./dist/validateSchema.d.ts",
			"import": "./dist/validateSchema.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"sideEffects": [
		"*.css"
	],
	"dependencies": {
		"ckeditor5-elements-actions": "workspace:*",
		"ckeditor5-elements-attributes": "workspace:*",
		"ckeditor5-elements-core": "workspace:*",
		"ckeditor5-elements-interaction": "workspace:*",
		"ckeditor5-elements-menu": "workspace:*",
		"ckeditor5-elements-schema": "workspace:*",
		"ckeditor5-elements-toolbar": "workspace:*"
	},
	"peerDependencies": {
		"ckeditor5": "^49.0.0"
	},
	"scripts": {
		"build": "tsc --build && node ../../scripts/buildUmbrellaStyles.js",
		"prepublishOnly": "npm run build"
	}
}
