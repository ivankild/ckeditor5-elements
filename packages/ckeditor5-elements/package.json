{
	"name": "ckeditor5-elements",
	"version": "49.0.0-alpha.0",
	"description": "Element commands, an element context menu, clipboard commands, quick insert and breadcrumbs for CKEditor 5.",
	"keywords": [
		"ckeditor",
		"ckeditor5",
		"ckeditor 5",
		"ckeditor5-feature",
		"ckeditor5-plugin"
	],
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./index.css": "./dist/index.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"sideEffects": [
		"*.css"
	],
	"dependencies": {
		"ckeditor5-elements-breadcrumbs": "workspace:*",
		"ckeditor5-elements-clipboard": "workspace:*",
		"ckeditor5-elements-context-menu": "workspace:*",
		"ckeditor5-elements-core": "workspace:*",
		"ckeditor5-elements-quick-insert": "workspace:*"
	},
	"peerDependencies": {
		"ckeditor5": ">=49.0.0"
	},
	"scripts": {
		"build": "tsc --build && node ../../scripts/buildUmbrellaStyles.js",
		"prepublishOnly": "npm run build"
	}
}
