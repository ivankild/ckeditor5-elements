{
	"name": "ckeditor5-elements",
	"version": "0.1.0",
	"description": "An example element feature for CKEditor 5, built on ckeditor5-elements-ui.",
	"keywords": [
		"ckeditor",
		"ckeditor5",
		"ckeditor 5",
		"ckeditor5-feature",
		"ckeditor5-plugin"
	],
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"dependencies": {
		"ckeditor5-elements-ui": "workspace:^"
	},
	"peerDependencies": {
		"ckeditor5": ">=46.0.0"
	},
	"scripts": {
		"build": "tsc --build",
		"prepublishOnly": "npm run build"
	}
}
