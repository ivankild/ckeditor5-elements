{
	"name": "ckeditor5-elements-clickable",
	"version": "49.0.0-alpha.1",
	"description": "Clickable elements for CKEditor 5: call a function, with the model element, when an element that matches a name or a filter is clicked or double-clicked.",
	"keywords": [
		"ckeditor",
		"ckeditor5",
		"ckeditor 5",
		"ckeditor5-feature",
		"ckeditor5-plugin"
	],
	"license": "MIT",
	"author": "Ivan Kildyushov",
	"homepage": "https://ivankild.github.io/ckeditor5-elements/guide/clickable",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ivankild/ckeditor5-elements.git",
		"directory": "packages/ckeditor5-elements-clickable"
	},
	"bugs": {
		"url": "https://github.com/ivankild/ckeditor5-elements/issues"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"sideEffects": false,
	"dependencies": {
		"ckeditor5-elements-core": "workspace:*"
	},
	"peerDependencies": {
		"ckeditor5": "^49.0.0"
	},
	"scripts": {
		"build": "tsc --build",
		"prepublishOnly": "npm run build"
	}
}
