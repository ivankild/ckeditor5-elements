{
	"name": "ckeditor5-elements-breadcrumbs",
	"version": "49.0.0-alpha.0",
	"description": "Breadcrumbs for CKEditor 5: the element path at the selection, as a toolbar component.",
	"keywords": [
		"ckeditor",
		"ckeditor5",
		"ckeditor 5",
		"ckeditor5-feature",
		"ckeditor5-plugin"
	],
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./index.css": "./theme/breadcrumbs.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"theme",
		"README.md"
	],
	"sideEffects": [
		"*.css"
	],
	"peerDependencies": {
		"ckeditor5": ">=49.0.0"
	},
	"scripts": {
		"build": "tsc --build",
		"prepublishOnly": "npm run build"
	}
}
